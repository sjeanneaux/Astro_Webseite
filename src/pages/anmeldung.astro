---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout title="Anmeldung" description="Anmeldung an der WKS - Alle Informationen, Checkliste und Kontaktformular fuer deine Anmeldung an der Werkstattschule.">
  <HeroSection
    title='Deine <span class="text-orange-500">Anmeldung</span>'
    subtitle="Alle Informationen, die du fuer deine Anmeldung an der WKS brauchst. Einfach, uebersichtlich und direkt."
    compact={true}
  />

  <section class="py-16 sm:py-24 bg-white" aria-labelledby="ablauf-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <span class="inline-block px-4 py-1.5 bg-orange-50 text-orange-600 text-sm font-semibold rounded-full mb-4">So funktioniert es</span>
        <h2 id="ablauf-heading" class="text-3xl sm:text-4xl font-bold text-anthrazit-700 mb-4">
          Anmeldung in 3 Schritten
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <div class="relative bg-anthrazit-50 rounded-2xl p-8 text-center">
          <div class="w-12 h-12 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">1</div>
          <h3 class="text-xl font-bold text-anthrazit-700 mb-3">Informieren</h3>
          <p class="text-anthrazit-400 leading-relaxed">Lies dir die Informationen zu unseren Fachbereichen durch und entscheide, welcher Bereich zu dir passt.</p>
        </div>

        <div class="relative bg-anthrazit-50 rounded-2xl p-8 text-center">
          <div class="w-12 h-12 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">2</div>
          <h3 class="text-xl font-bold text-anthrazit-700 mb-3">Unterlagen sammeln</h3>
          <p class="text-anthrazit-400 leading-relaxed">Stelle alle benoetigten Unterlagen zusammen. Unsere Checkliste hilft dir dabei, nichts zu vergessen.</p>
        </div>

        <div class="relative bg-anthrazit-50 rounded-2xl p-8 text-center">
          <div class="w-12 h-12 bg-orange-500 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-6">3</div>
          <h3 class="text-xl font-bold text-anthrazit-700 mb-3">Anmelden</h3>
          <p class="text-anthrazit-400 leading-relaxed">Fuell das Kontaktformular aus oder komm persoenlich im Sekretariat vorbei. Wir helfen dir gerne weiter.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-anthrazit-50" aria-labelledby="checkliste-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <span class="inline-block px-4 py-1.5 bg-orange-50 text-orange-600 text-sm font-semibold rounded-full mb-4">Checkliste</span>
          <h2 id="checkliste-heading" class="text-3xl sm:text-4xl font-bold text-anthrazit-700 mb-6">
            Das brauchst du fuer die Anmeldung
          </h2>
          <p class="text-anthrazit-400 text-lg leading-relaxed mb-8">
            Damit deine Anmeldung reibungslos ablaeuft, haben wir eine Checkliste mit allen benoetigten Unterlagen zusammengestellt.
          </p>

          <ul class="space-y-4" role="list">
            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Letztes Zeugnis</span>
                <p class="text-anthrazit-400 text-sm mt-1">Kopie des letzten Schulzeugnisses (beglaubigt)</p>
              </div>
            </li>

            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Personalausweis</span>
                <p class="text-anthrazit-400 text-sm mt-1">Kopie des Personalausweises oder Reisepasses</p>
              </div>
            </li>

            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Passfoto</span>
                <p class="text-anthrazit-400 text-sm mt-1">Ein aktuelles biometrisches Passfoto</p>
              </div>
            </li>

            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Lebenslauf</span>
                <p class="text-anthrazit-400 text-sm mt-1">Tabellarischer Lebenslauf mit Lichtbild</p>
              </div>
            </li>

            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Anmeldeformular</span>
                <p class="text-anthrazit-400 text-sm mt-1">Ausgefuelltes Anmeldeformular (im Sekretariat erhaeltlich oder unten absenden)</p>
              </div>
            </li>

            <li class="flex items-start gap-4 bg-white rounded-xl p-4 border border-anthrazit-100 shadow-sm">
              <div class="w-6 h-6 bg-orange-500 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <span class="font-semibold text-anthrazit-700">Bei Minderjaehrigen: Einverstaendnis der Erziehungsberechtigten</span>
                <p class="text-anthrazit-400 text-sm mt-1">Unterschrift eines Erziehungsberechtigten auf dem Anmeldeformular</p>
              </div>
            </li>
          </ul>
        </div>

        <div>
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-anthrazit-100 shadow-sm mb-8">
            <h3 class="text-xl font-bold text-anthrazit-700 mb-2">Anmeldezeitraum</h3>
            <p class="text-anthrazit-400 leading-relaxed mb-4">
              Die regulaere Anmeldephase fuer das kommende Schuljahr laeuft von <strong class="text-anthrazit-700">Februar bis April</strong>. Spaetere Anmeldungen sind nach Verfuegbarkeit moeglich.
            </p>
            <div class="bg-orange-50 rounded-xl p-4 border border-orange-100">
              <p class="text-orange-700 text-sm font-medium">
                Tipp: Je frueher du dich anmeldest, desto besser stehen deine Chancen auf deinen Wunsch-Fachbereich!
              </p>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-anthrazit-100 shadow-sm">
            <h3 class="text-xl font-bold text-anthrazit-700 mb-2">Schnelle Hilfe</h3>
            <p class="text-anthrazit-400 leading-relaxed mb-4">
              Fragen zur Anmeldung? Schreib uns einfach per WhatsApp - wir antworten schnell und unkompliziert.
            </p>
            <a
              href="https://wa.me/4912345678?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20Anmeldung%20an%20der%20WKS."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp-Kontakt
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-white" aria-labelledby="formular-heading">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 bg-orange-50 text-orange-600 text-sm font-semibold rounded-full mb-4">Kontaktformular</span>
        <h2 id="formular-heading" class="text-3xl sm:text-4xl font-bold text-anthrazit-700 mb-4">
          Schreib uns eine Nachricht
        </h2>
        <p class="text-anthrazit-400 text-lg">
          Fuell das Formular aus und wir melden uns schnellstmoeglich bei dir.
        </p>
      </div>

      <form class="space-y-6" action="#" method="POST">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="vorname" class="block text-sm font-semibold text-anthrazit-700 mb-2">Vorname *</label>
            <input
              type="text"
              id="vorname"
              name="vorname"
              required
              class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 placeholder-anthrazit-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow"
              placeholder="Dein Vorname"
            />
          </div>
          <div>
            <label for="nachname" class="block text-sm font-semibold text-anthrazit-700 mb-2">Nachname *</label>
            <input
              type="text"
              id="nachname"
              name="nachname"
              required
              class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 placeholder-anthrazit-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow"
              placeholder="Dein Nachname"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-anthrazit-700 mb-2">E-Mail *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 placeholder-anthrazit-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow"
            placeholder="deine@email.de"
          />
        </div>

        <div>
          <label for="telefon" class="block text-sm font-semibold text-anthrazit-700 mb-2">Telefon</label>
          <input
            type="tel"
            id="telefon"
            name="telefon"
            class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 placeholder-anthrazit-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow"
            placeholder="0123 / 456 789"
          />
        </div>

        <div>
          <label for="fachbereich" class="block text-sm font-semibold text-anthrazit-700 mb-2">Gewuenschter Fachbereich *</label>
          <select
            id="fachbereich"
            name="fachbereich"
            required
            class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow"
          >
            <option value="">Bitte waehlen...</option>
            <option value="metalltechnik">Metalltechnik</option>
            <option value="wirtschaft">Wirtschaft</option>
          </select>
        </div>

        <div>
          <label for="nachricht" class="block text-sm font-semibold text-anthrazit-700 mb-2">Nachricht</label>
          <textarea
            id="nachricht"
            name="nachricht"
            rows="4"
            class="w-full px-4 py-3 rounded-xl border border-anthrazit-200 bg-white text-anthrazit-700 placeholder-anthrazit-300 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-shadow resize-y"
            placeholder="Hast du Fragen oder moechtest du uns etwas mitteilen?"
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="datenschutz"
            name="datenschutz"
            required
            class="mt-1 w-4 h-4 text-orange-500 border-anthrazit-200 rounded focus:ring-orange-500"
          />
          <label for="datenschutz" class="text-sm text-anthrazit-400">
            Ich habe die <a href="#" class="text-orange-500 hover:text-orange-600 underline">Datenschutzerklaerung</a> gelesen und bin mit der Verarbeitung meiner Daten einverstanden. *
          </label>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-orange-500 text-white font-semibold rounded-xl hover:bg-orange-600 transition-all hover:shadow-lg hover:shadow-orange-500/25 text-lg"
        >
          Nachricht absenden
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </form>
    </div>
  </section>
</Layout>
