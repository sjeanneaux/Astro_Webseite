---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout title="Kontakt" description="Kontakt zur WKS - Telefon, E-Mail, WhatsApp und Oeffnungszeiten. Wir sind fuer dich da!">
  <HeroSection
    title='Wir sind <span class="text-orange-500">fuer dich da</span>'
    subtitle="Ob per Telefon, E-Mail oder WhatsApp - wir beantworten deine Fragen schnell und unkompliziert."
    compact={true}
  />

  <section class="py-16 sm:py-24 bg-white" aria-labelledby="kontakt-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        <div class="bg-anthrazit-50 rounded-2xl p-8 text-center border border-anthrazit-100">
          <div class="w-14 h-14 bg-orange-500/10 text-orange-500 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-anthrazit-700 mb-2">Telefon</h3>
          <a href="tel:+4912345678" class="text-orange-500 hover:text-orange-600 font-semibold text-lg transition-colors">01234 / 56 78</a>
          <p class="text-anthrazit-400 text-sm mt-2">Mo - Fr: 8:00 - 15:00 Uhr</p>
        </div>

        <div class="bg-anthrazit-50 rounded-2xl p-8 text-center border border-anthrazit-100">
          <div class="w-14 h-14 bg-orange-500/10 text-orange-500 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-anthrazit-700 mb-2">E-Mail</h3>
          <a href="mailto:info@wks-schule.de" class="text-orange-500 hover:text-orange-600 font-semibold text-lg transition-colors">info@wks-schule.de</a>
          <p class="text-anthrazit-400 text-sm mt-2">Wir antworten innerhalb von 24h</p>
        </div>

        <div class="bg-green-50 rounded-2xl p-8 text-center border border-green-100">
          <div class="w-14 h-14 bg-green-500/10 text-green-500 rounded-xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-anthrazit-700 mb-2">WhatsApp</h3>
          <a
            href="https://wa.me/4912345678?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20WKS."
            target="_blank"
            rel="noopener noreferrer"
            class="text-green-600 hover:text-green-700 font-semibold text-lg transition-colors"
          >
            Nachricht senden
          </a>
          <p class="text-anthrazit-400 text-sm mt-2">Schnelle Antworten garantiert</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <h2 id="kontakt-heading" class="text-3xl sm:text-4xl font-bold text-anthrazit-700 mb-8">
            Besuch uns vor Ort
          </h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-orange-500/10 text-orange-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-anthrazit-700 mb-1">Adresse</h3>
                <address class="not-italic text-anthrazit-400 leading-relaxed">
                  Werner-von-Siemens Schule<br />
                  Werkstattschule (WKS)<br />
                  Musterstrasse 42<br />
                  12345 Musterstadt
                </address>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-orange-500/10 text-orange-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-anthrazit-700 mb-1">Oeffnungszeiten Sekretariat</h3>
                <div class="text-anthrazit-400 leading-relaxed space-y-1">
                  <div class="flex justify-between gap-8">
                    <span>Montag - Donnerstag</span>
                    <span class="font-medium text-anthrazit-600">7:30 - 15:30 Uhr</span>
                  </div>
                  <div class="flex justify-between gap-8">
                    <span>Freitag</span>
                    <span class="font-medium text-anthrazit-600">7:30 - 13:00 Uhr</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-orange-500/10 text-orange-500 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-anthrazit-700 mb-1">Krankmeldungen</h3>
                <p class="text-anthrazit-400 leading-relaxed">
                  Krankmeldungen bitte bis 8:00 Uhr per Telefon oder WhatsApp an das Sekretariat.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="aspect-[4/3] bg-gradient-to-br from-anthrazit-100 to-anthrazit-200 rounded-2xl flex items-center justify-center" role="img" aria-label="Platzhalter fuer Kartenansicht">
            <div class="text-center">
              <svg class="w-16 h-16 text-anthrazit-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <span class="text-anthrazit-400 text-sm">Kartenansicht</span>
              <p class="text-anthrazit-300 text-xs mt-1">Hier wird spaeter eine interaktive Karte eingebunden</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-anthrazit-50" aria-labelledby="whatsapp-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-anthrazit-700 rounded-3xl p-8 sm:p-12 lg:p-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
          <div>
            <h2 id="whatsapp-heading" class="text-3xl sm:text-4xl font-bold text-white mb-6">
              Direkter Draht per WhatsApp
            </h2>
            <p class="text-anthrazit-200 text-lg leading-relaxed mb-6">
              Unser WhatsApp-Service ist die schnellste Art, Antworten auf deine Fragen zu bekommen. Egal ob Anmeldung, Krankmeldung oder allgemeine Fragen - schreib uns einfach!
            </p>
            <ul class="space-y-3 mb-8" role="list">
              <li class="flex items-center gap-3 text-anthrazit-200">
                <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Schnelle Antworten auf haeufige Fragen
              </li>
              <li class="flex items-center gap-3 text-anthrazit-200">
                <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Krankmeldungen unkompliziert absenden
              </li>
              <li class="flex items-center gap-3 text-anthrazit-200">
                <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Anmelde-Checklisten direkt aufs Handy
              </li>
              <li class="flex items-center gap-3 text-anthrazit-200">
                <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                KI-gestuetzte Sofort-Antworten ausserhalb der Buerozeiten
              </li>
            </ul>
            <a
              href="https://wa.me/4912345678?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zur%20WKS."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-8 py-4 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-all hover:shadow-lg text-lg"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Jetzt per WhatsApp schreiben
            </a>
          </div>

          <div class="hidden lg:flex items-center justify-center">
            <div class="w-72 bg-anthrazit-600 rounded-3xl p-6 shadow-2xl">
              <div class="bg-green-600 rounded-2xl p-4 mb-4">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                    <span class="text-white font-bold text-sm">WKS</span>
                  </div>
                  <div>
                    <span class="text-white font-semibold text-sm block">WKS Werkstattschule</span>
                    <span class="text-green-200 text-xs">Online</span>
                  </div>
                </div>
              </div>

              <div class="space-y-3">
                <div class="bg-anthrazit-500 rounded-2xl rounded-tl-sm p-3 max-w-[85%]">
                  <p class="text-white text-sm">Hallo! Wie kann ich dir helfen? Frag mich zur Anmeldung, Fachbereichen oder Terminen.</p>
                  <span class="text-anthrazit-300 text-xs mt-1 block text-right">09:15</span>
                </div>

                <div class="bg-orange-500 rounded-2xl rounded-tr-sm p-3 max-w-[85%] ml-auto">
                  <p class="text-white text-sm">Was brauche ich fuer die Anmeldung?</p>
                  <span class="text-orange-200 text-xs mt-1 block text-right">09:16</span>
                </div>

                <div class="bg-anthrazit-500 rounded-2xl rounded-tl-sm p-3 max-w-[85%]">
                  <p class="text-white text-sm">Fuer die Anmeldung benoetigst du: Zeugnis, Ausweis, Passfoto, Lebenslauf und das Anmeldeformular.</p>
                  <span class="text-anthrazit-300 text-xs mt-1 block text-right">09:16</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
