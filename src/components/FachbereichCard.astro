---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color?: 'orange' | 'blue' | 'green';
}

const { title, description, href, icon, color = 'orange' } = Astro.props;

const iconColors = {
  orange: 'bg-orange-500/10 text-orange-500',
  blue: 'bg-blue-500/10 text-blue-500',
  green: 'bg-green-500/10 text-green-500',
};

const hoverColors = {
  orange: 'group-hover:bg-orange-500',
  blue: 'group-hover:bg-blue-500',
  green: 'group-hover:bg-green-500',
};
---

<a href={href} class="group block bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-anthrazit-50 hover:border-orange-200 hover:-translate-y-1">
  <div class:list={['w-14 h-14 rounded-xl flex items-center justify-center mb-5 transition-colors duration-300', iconColors[color], hoverColors[color], 'group-hover:text-white']}>
    <Fragment set:html={icon} />
  </div>

  <h3 class="text-xl font-bold text-anthrazit-700 mb-3 group-hover:text-orange-500 transition-colors">
    {title}
  </h3>

  <p class="text-anthrazit-400 leading-relaxed mb-4">
    {description}
  </p>

  <span class="inline-flex items-center text-orange-500 font-semibold text-sm">
    Mehr erfahren
    <svg class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </span>
</a>
