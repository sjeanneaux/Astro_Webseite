---
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  compact?: boolean;
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref = '/anmeldung',
  secondaryCtaText,
  secondaryCtaHref,
  compact = false,
} = Astro.props;
---

<section class:list={[
  'relative overflow-hidden bg-anthrazit-700',
  compact ? 'pt-24 pb-12 sm:pt-28 sm:pb-16' : 'pt-28 pb-16 sm:pt-36 sm:pb-24 lg:pt-44 lg:pb-32',
]}>
  <div class="absolute inset-0 opacity-10" aria-hidden="true">
    <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-orange-600 rounded-full blur-3xl -translate-x-1/4 translate-y-1/4"></div>
  </div>

  <div class="absolute inset-0 opacity-5" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class:list={[
      'max-w-3xl',
      compact ? '' : 'lg:max-w-4xl',
    ]}>
      <h1 class:list={[
        'font-bold text-white leading-tight',
        compact ? 'text-3xl sm:text-4xl lg:text-5xl' : 'text-4xl sm:text-5xl lg:text-6xl xl:text-7xl',
      ]}>
        <Fragment set:html={title} />
      </h1>

      {subtitle && (
        <p class:list={[
          'mt-4 sm:mt-6 text-anthrazit-200 leading-relaxed',
          compact ? 'text-base sm:text-lg' : 'text-lg sm:text-xl lg:text-2xl',
        ]}>
          {subtitle}
        </p>
      )}

      {(ctaText || secondaryCtaText) && (
        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-4">
          {ctaText && (
            <a
              href={ctaHref}
              class="inline-flex items-center justify-center px-8 py-4 bg-orange-500 text-white font-semibold rounded-xl hover:bg-orange-600 transition-all hover:shadow-lg hover:shadow-orange-500/25 text-base sm:text-lg"
            >
              {ctaText}
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          )}
          {secondaryCtaText && secondaryCtaHref && (
            <a
              href={secondaryCtaHref}
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-anthrazit-400 text-white font-semibold rounded-xl hover:border-orange-400 hover:text-orange-400 transition-all text-base sm:text-lg"
            >
              {secondaryCtaText}
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  {!compact && (
    <div class="absolute bottom-0 right-0 w-1/3 h-full hidden lg:flex items-end justify-end" aria-hidden="true">
      <div class="w-80 h-80 bg-gradient-to-br from-orange-500/20 to-orange-600/10 rounded-tl-3xl flex items-center justify-center">
        <svg class="w-32 h-32 text-orange-500/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
    </div>
  )}
</section>
