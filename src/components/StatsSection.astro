---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const { stats = [
  { value: '500+', label: 'Schülerinnen & Schüler' },
  { value: '95%', label: 'Erfolgsquote' },
  { value: '30+', label: 'Jahre Erfahrung' },
  { value: '12', label: 'Werkstätten' },
] } = Astro.props;
---

<section class="bg-anthrazit-700 py-12 sm:py-16" aria-label="Statistiken der WKS">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-12">
      {stats.map((stat) => (
        <div class="text-center">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-orange-500 mb-2">
            {stat.value}
          </div>
          <div class="text-anthrazit-200 text-sm sm:text-base">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
