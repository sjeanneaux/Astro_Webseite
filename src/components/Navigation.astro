---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/metalltechnik', label: 'Metalltechnik' },
  { href: '/wirtschaft', label: 'Wirtschaft' },
  { href: '/anmeldung', label: 'Anmeldung' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-anthrazit-700/95 backdrop-blur-sm shadow-lg">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Hauptnavigation">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <a href="/" class="flex items-center gap-3 group" aria-label="WKS Startseite">
        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-orange-500 rounded-lg flex items-center justify-center font-bold text-white text-lg sm:text-xl transition-transform group-hover:scale-105">
          W
        </div>
        <div class="hidden sm:block">
          <span class="text-white font-bold text-lg leading-tight block">WKS</span>
          <span class="text-anthrazit-200 text-xs leading-tight block">Werkstattschule</span>
        </div>
      </a>

      <ul class="hidden md:flex items-center gap-1" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-medium transition-colors',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'bg-orange-500 text-white'
                  : 'text-anthrazit-100 hover:text-white hover:bg-anthrazit-600',
              ]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <label for="mobile-menu-toggle" class="md:hidden relative w-10 h-10 flex items-center justify-center cursor-pointer text-white hover:text-orange-400 transition-colors" aria-label="Menü öffnen">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </nav>

  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" aria-hidden="true" />

  <div class="md:hidden max-h-0 overflow-hidden peer-checked:max-h-96 transition-all duration-300 bg-anthrazit-800">
    <ul class="px-4 py-3 space-y-1" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'block px-4 py-3 rounded-lg text-sm font-medium transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'bg-orange-500 text-white'
                : 'text-anthrazit-100 hover:text-white hover:bg-anthrazit-600',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
