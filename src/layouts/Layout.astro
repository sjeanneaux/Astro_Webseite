---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'WKS - Werner-von-Siemens Schule / Werkstattschule. Hier entsteht Zukunft durch praxisnahe Ausbildung in Metalltechnik, Wirtschaft und mehr.' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | WKS Werkstattschule</title>
  </head>
  <body class="min-h-screen bg-white text-anthrazit-700 font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-orange-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      Zum Hauptinhalt springen
    </a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
